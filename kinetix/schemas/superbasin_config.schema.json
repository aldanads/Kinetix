{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/aldanads/Kinetix/schemas/superbasin_config.schema.json",
  "type": "object",
  "title": "SuperbasinConfig",
  "properties": {
    "enabled_superbasin": {
      "type": "boolean",
      "default": false
    },
    "n_search_superbasin": {
      "type": "integer",
      "default": 50
    },
    "time_step_limits": {
      "type": "number",
      "default": 0.0001
    },
    "E_min": {
      "type": "number",
      "default": 0.5
    },
    "energy_step": {
      "type": "number",
      "default": 0.05
    },
    "time_based_superbasin": {
      "type": "boolean",
      "default": true
    }
  },
  "additionalProperties": false,
  "description": "Superbasin acceleration parameters."
}
