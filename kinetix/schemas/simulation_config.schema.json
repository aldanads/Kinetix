          "description": "Cluster radii such as {\"R_active\": 5.0, \"R_shell\": 7.0}, or None for a full periodic NEB.",
          "default": null
        },
        "cache_dir": {
          "type": "string",
          "description": "Directory for caching computed barriers.",
          "default": "data/cache/neb_cache"
        },
        "interstitial_refinement": {
          "anyOf": [
            {
              "$ref": "#/$defs/InterstitialRefinementConfig"
            },
            {
              "type": "null"
            }
          ],
          "description": "Optional interstitial refinement settings.",
          "default": null
        }
      },
      "additionalProperties": false,
      "description": "Activation-energy calculator parameters.\n\nAttributes:\n    type: Calculator type, either \"mace_neb\" or \"tabulated\".\n    model: Local model path or Hugging Face repository ID.\n    model_filename: Filename of the model inside the HF repo, used only\n        when ``model`` is a repository ID.\n    n_images: Number of NEB images.\n    fmax: Force convergence criterion in eV/Angstrom.\n    max_steps: Maximum optimizer steps for the NEB relaxation.\n    device: Torch device, \"cpu\" or \"cuda\".\n    default_dtype: Torch default dtype name (e.g. \"float64\").\n    cluster: Cluster radii such as {\"R_active\": 5.0, \"R_shell\": 7.0},\n        or None for a full periodic NEB.\n    cache_dir: Directory for caching computed barriers.\n    interstitial_refinement: Optional interstitial refinement settings."
    },
